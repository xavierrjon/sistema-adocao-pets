{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "db:validate": "tsx src/lib/validate-database-connection.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.0.0",
    "prisma": "^6.19.3",
    "tsx": "4.19.0",
    "typescript": "5.6.3"
  }
}
