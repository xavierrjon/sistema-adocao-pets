# Banco de dados (PostgreSQL)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Porta exposta pelo container do Docker. Se a 5432 já estiver ocupada
# (ex.: PostgreSQL instalado na própria máquina), use outra, como 5433,
# e ajuste a porta na DATABASE_URL também.
POSTGRES_PORT=5432

# Backend
PORT=3001
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Cookies de sessão
# Use "lax" quando frontend e backend compartilham o mesmo site (ex.: localhost
# em portas diferentes). Use "none" (com COOKIE_DOMAIN e HTTPS) quando estiverem
# em domínios diferentes.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.seusdominio.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api