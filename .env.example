# Banco de dados (PostgreSQL)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Porta exposta pelo container do Docker. Se a 5432 já estiver ocupada
# (ex.: PostgreSQL instalado na própria máquina), use outra, como 5433,
# e ajuste a porta na DATABASE_URL também.
POSTGRES_PORT=5432

# Backend
PORT=3001
DATABASE_URL=
# URL direta (sem pool) usada pelo Prisma para migrations e comandos administrativos.
# Localmente aponta para o mesmo PostgreSQL do Docker; em produção, use a URL
# direct do Prisma Postgres configurada na Vercel.
DIRECT_URL=
# Origens permitidas por CORS e pela checagem de Origin do CSRF.
# Aceita várias origens separadas por vírgula. A origem publicada do frontend
# (https://adoteja-am.vercel.app) já é permitida por padrão, assim como
# localhost fora de produção.
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Cookies de sessão
# Use "lax" quando o navegador acessa a API pelo mesmo domínio do frontend
# (deploy com proxy de rewrites no Next.js e ambiente local). "none" só é
# necessário quando o navegador chama um domínio diferente do frontend
# diretamente (cross-site); exige HTTPS.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.seusdominio.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Armazenamento de imagens (Cloudinary) — usado pelo backend nas fotos dos anúncios.
# Crie uma conta gratuita em https://cloudinary.com (Dashboard > Settings > Access Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=