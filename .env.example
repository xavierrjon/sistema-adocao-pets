# Banco de dados (PostgreSQL)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Porta exposta pelo container do Docker. Se a 5432 já estiver ocupada
# (ex.: PostgreSQL instalado na própria máquina), use outra, como 5433,
# e ajuste a porta na DATABASE_URL também.
POSTGRES_PORT=5432

# Backend
PORT=3001
DATABASE_URL=
# Origens permitidas por CORS e pela checagem de Origin do CSRF.
# Aceita várias origens separadas por vírgula. As origens publicadas
# (https://adoteja-murex.vercel.app e https://adoteja-am.vercel.app) já são
# permitidas por padrão, assim como localhost fora de produção.
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Cookies de sessão
# Use "lax" quando frontend e backend compartilham o mesmo site (ex.: localhost
# em portas diferentes). Use "none" (com HTTPS) quando estiverem em domínios
# diferentes, como no deploy da Vercel (frontend e API em subdomínios distintos).
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.seusdominio.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Armazenamento de imagens (Cloudinary) — usado pelo backend nas fotos dos anúncios.
# Crie uma conta gratuita em https://cloudinary.com (Dashboard > Settings > Access Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=